# ─── Everything below is OPTIONAL. ────────────────────────────────────────────
# Both study registries are free public APIs and need no key, so `npm run
# ingest` pulls live records out of the box. With no keys at all it stores them
# in a local JSON file and extracts with rule-based heuristics instead of a
# model. Add a key to promote that one layer; nothing else changes.
#
# `npm run ingest:fixtures` replays captured records instead of calling the
# APIs. That is the offline path, and it has to be asked for.

# ── Storage ───────────────────────────────────────────────────────────────────
# Unset -> local JSON store at .data/store.json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM  (auto|gemini|groq|openrouter|mock) ───────────────────────────────────
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Full-text fetching  (auto|firecrawl|playwright|fetch|fixture) ────────────
# Used to pull population detail when a registry record omits it.
SCRAPE_PROVIDER=auto
FIRECRAWL_API_KEY=

# ── Webhook / cron auth ───────────────────────────────────────────────────────
# HMAC-SHA256 secret for POST /api/webhooks/refresh
WEBHOOK_SECRET=dev-secret-change-me
# Bearer token for GET /api/cron/ingest
CRON_SECRET=dev-cron-change-me

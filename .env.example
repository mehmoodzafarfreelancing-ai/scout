# ─── Everything below is OPTIONAL. ────────────────────────────────────────────
# With an empty .env.local the app still runs end-to-end using bundled HTML
# fixtures, a deterministic mock extractor, and a local JSON store.
# Add keys to promote each layer to the real service. Nothing else changes.

# ── Storage ───────────────────────────────────────────────────────────────────
# Unset -> local JSON store at .data/store.json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM  (auto|gemini|groq|openrouter|mock) ───────────────────────────────────
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Full-text fetching  (auto|firecrawl|playwright|fetch|fixture) ────────────
# Used to pull population detail when a registry record omits it.
SCRAPE_PROVIDER=auto
FIRECRAWL_API_KEY=

# ── Webhook / cron auth ───────────────────────────────────────────────────────
# HMAC-SHA256 secret for POST /api/webhooks/refresh
WEBHOOK_SECRET=dev-secret-change-me
# Bearer token for GET /api/cron/ingest
CRON_SECRET=dev-cron-change-me

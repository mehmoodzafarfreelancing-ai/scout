{
  "name": "scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/scripts/ingest.ts",
    "ingest:fixtures": "cross-env SCRAPE_PROVIDER=fixture LLM_PROVIDER=mock NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_ANON_KEY= tsx src/scripts/ingest.ts --budget=400 --per=40",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "eval": "tsx src/scripts/eval.ts",
    "eval:baseline": "cross-env LLM_PROVIDER=mock tsx src/scripts/eval.ts",
    "capture": "tsx src/scripts/capture.ts",
    "seed:store": "cross-env SCRAPE_PROVIDER=fixture LLM_PROVIDER=mock tsx src/scripts/ingest.ts --budget=400 --per=40"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "next": "^16.3.3",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
